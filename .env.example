# Opcjonalne, niesekretne ustawienia Docker Compose.
# Kopia .env pozostaje lokalna i jest ignorowana przez Git.
APP_PORT=8789
# Dotyczy tylko publicznego podglądu. Osobisty tok rozpoznaje USOS automatycznie.
TIMETABLE_TRACK_ID=958

# Puste = lokalne HTTP. Na Azure ustaw rzeczywisty origin HTTPS bez końcowego /.
PILOT_PUBLIC_ORIGIN=
PILOT_MAX_BROWSERS=5
# Rejestracja aplikacji i callbacki: docs/11-logowanie-google-microsoft.md
# Sekrety ustaw lokalnie / przez konfigurację sekretów Azure, nigdy w repo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Rejestracja wymaga tego kodu (16-256 bajtów). Puste = rejestracja zamknięta.
# Kod jest sekretem; nigdy nie wpisuj go do .env.example ani do repo.
PILOT_REGISTRATION_CODE=
